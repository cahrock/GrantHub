// GrantHub - Prisma schema
// Rockville University research grants management portal
//
// Conventions used in this schema:
//   - Tables are named in PascalCase singular (Grant, Deliverable)
//   - Enums use SCREAMING_SNAKE_CASE for values
//   - All timestamp columns are UTC; the app converts at the edge
//   - createdAt / updatedAt on every mutable entity
//   - Soft deletes are intentionally NOT used; deletes go through the audit log
//   - Foreign keys are indexed automatically by Prisma; additional indexes are
//     added on columns the reporting queries filter or sort on
//
// To regenerate the client after editing this file:
//   npx prisma generate
// To create a migration:
//   npx prisma migrate dev --name <descriptive-name>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
//  Lookup tables
// =============================================================================

/// Institutional context. Single-tenant for the MVP, but modeled as a table
/// so multi-tenancy is a future possibility without a schema rewrite.
model Institution {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  shortName String   @unique @db.VarChar(50)
  createdAt DateTime @default(now())

  departments     Department[]
  fundingAgencies FundingAgency[]
  fiscalYears     FiscalYear[]
  grants          Grant[]
  users           User[]

  @@map("institutions")
}

/// Academic departments at the institution.
model Department {
  id            Int     @id @default(autoincrement())
  institutionId Int
  name          String  @db.VarChar(150)
  code          String  @db.VarChar(20)
  active        Boolean @default(true)

  institution Institution @relation(fields: [institutionId], references: [id])
  grants      Grant[]
  users       User[]

  @@unique([institutionId, code])
  @@index([institutionId, active])
  @@map("departments")
}

/// Sponsoring organizations (NSF, NIH, DOE, etc.).
model FundingAgency {
  id            Int     @id @default(autoincrement())
  institutionId Int
  name          String  @db.VarChar(200)
  shortName     String  @db.VarChar(20)
  agencyType    AgencyType
  active        Boolean @default(true)

  institution Institution @relation(fields: [institutionId], references: [id])
  grants      Grant[]

  @@unique([institutionId, shortName])
  @@index([institutionId, active])
  @@map("funding_agencies")
}

/// Fiscal year reference (e.g. FY2025 = July 1 2024 to June 30 2025 at Rockville).
/// Stored as discrete rows so reporting queries can group cleanly.
model FiscalYear {
  id            Int      @id @default(autoincrement())
  institutionId Int
  label         String   @db.VarChar(10) // "FY2025"
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  closed        Boolean  @default(false)

  institution  Institution   @relation(fields: [institutionId], references: [id])
  grants       Grant[]
  deliverables Deliverable[]
  funding      Funding[]

  @@unique([institutionId, label])
  @@index([institutionId, startDate])
  @@map("fiscal_years")
}

// =============================================================================
//  Identity
// =============================================================================

/// User identity is owned by Auth0; this table is a local projection plus
/// app-specific role / department metadata.
model User {
  id            Int       @id @default(autoincrement())
  institutionId Int
  /// Auth0 `sub` claim. Null only briefly during JIT provisioning.
  auth0Sub      String?   @unique @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  firstName     String    @db.VarChar(100)
  lastName      String    @db.VarChar(100)
  /// Faculty title for display ("Associate Professor", "Office of Research").
  title         String?   @db.VarChar(150)
  role          UserRole  @default(PI)
  /// Home department for PIs; null for research administrators and system admins.
  departmentId  Int?
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution         Institution    @relation(fields: [institutionId], references: [id])
  department          Department?    @relation(fields: [departmentId], references: [id])
  grantRoles          GrantRole[]
  createdGrants       Grant[]        @relation("GrantCreator")
  approvedGrants      Grant[]        @relation("GrantApprover")
  assignedDeliverables Deliverable[] @relation("DeliverableAssignee")
  uploadedAttachments Attachment[]
  auditEntries        AuditLog[]

  @@index([institutionId, role, active])
  @@index([departmentId])
  @@map("users")
}

// =============================================================================
//  Core domain
// =============================================================================

/// A funded research project. The central entity around which everything else turns.
model Grant {
  id              Int         @id @default(autoincrement())
  institutionId   Int
  /// Internal grant identifier ("RU-25-0042"). Surfaced in the UI.
  grantNumber     String      @unique @db.VarChar(30)
  title           String      @db.VarChar(300)
  abstract        String      @db.Text
  status          GrantStatus @default(DRAFT)
  departmentId    Int
  fundingAgencyId Int
  fiscalYearId    Int
  /// Sponsor's identifier for the award ("NSF-2412345"), if known.
  sponsorAwardId  String?     @db.VarChar(100)
  /// Total approved budget across the life of the award, in USD.
  totalBudget     Decimal     @db.Decimal(12, 2)
  /// Period of performance.
  startDate       DateTime?   @db.Date
  endDate         DateTime?   @db.Date

  /// Audit fields.
  createdById     Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  submittedAt     DateTime?
  approvedById    Int?
  approvedAt      DateTime?
  closedAt        DateTime?

  institution   Institution   @relation(fields: [institutionId], references: [id])
  department    Department    @relation(fields: [departmentId], references: [id])
  fundingAgency FundingAgency @relation(fields: [fundingAgencyId], references: [id])
  fiscalYear    FiscalYear    @relation(fields: [fiscalYearId], references: [id])
  createdBy     User          @relation("GrantCreator", fields: [createdById], references: [id])
  approvedBy    User?         @relation("GrantApprover", fields: [approvedById], references: [id])

  roles        GrantRole[]
  deliverables Deliverable[]
  funding      Funding[]

  @@index([institutionId, status])
  @@index([departmentId, fiscalYearId])
  @@index([fundingAgencyId, fiscalYearId])
  @@index([fiscalYearId, status])
  @@map("grants")
}

/// User membership on a grant, with role. Many-to-many between User and Grant.
model GrantRole {
  id          Int           @id @default(autoincrement())
  grantId     Int
  userId      Int
  role        GrantRoleType
  assignedAt  DateTime      @default(now())

  grant Grant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([grantId, userId])
  @@index([userId])
  @@map("grant_roles")
}

/// A unit of work owed under a grant: progress report, dataset release,
/// publication, or milestone.
model Deliverable {
  id           Int                @id @default(autoincrement())
  grantId      Int
  fiscalYearId Int
  type         DeliverableType
  title        String             @db.VarChar(300)
  description  String?            @db.Text
  status       DeliverableStatus  @default(NOT_STARTED)
  dueDate      DateTime           @db.Date
  /// PI or co-PI responsible for completing this item.
  assigneeId   Int?
  submittedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  grant       Grant         @relation(fields: [grantId], references: [id], onDelete: Cascade)
  fiscalYear  FiscalYear    @relation(fields: [fiscalYearId], references: [id])
  assignee    User?         @relation("DeliverableAssignee", fields: [assigneeId], references: [id])
  attachments Attachment[]

  @@index([grantId, status])
  @@index([assigneeId, status])
  @@index([dueDate, status]) // Powers the "overdue" report.
  @@index([fiscalYearId, type])
  @@map("deliverables")
}

/// Annual budget allocation per grant per fiscal year.
/// Lets the dashboard show planned-vs-actual burn over time.
model Funding {
  id            Int      @id @default(autoincrement())
  grantId       Int
  fiscalYearId  Int
  plannedAmount Decimal  @db.Decimal(12, 2)
  actualAmount  Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?  @db.VarChar(500)
  updatedAt     DateTime @updatedAt

  grant      Grant      @relation(fields: [grantId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])

  @@unique([grantId, fiscalYearId])
  @@map("funding")
}

/// File metadata for deliverable attachments.
/// Bytes live on S3-compatible storage; this table stores metadata only.
model Attachment {
  id            Int      @id @default(autoincrement())
  deliverableId Int
  fileName      String   @db.VarChar(255)
  mimeType      String   @db.VarChar(100)
  /// Bytes — UNSIGNED would be nice but Prisma + MySQL keep it signed BIGINT.
  sizeBytes     BigInt
  storageKey    String   @db.VarChar(500)
  uploadedById  Int
  uploadedAt    DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation(fields: [uploadedById], references: [id])

  @@index([deliverableId])
  @@map("attachments")
}

// =============================================================================
//  Audit log
// =============================================================================

/// Append-only record of significant system actions: state transitions,
/// permission changes, and AI search queries. Never deleted, never updated.
model AuditLog {
  id         BigInt        @id @default(autoincrement())
  /// The user performing the action. Null is reserved for future system actions.
  actorId    Int?
  action     AuditAction
  /// Type of resource the action affected (e.g. "Grant", "User", "Deliverable", "AISearch").
  entityType String        @db.VarChar(50)
  /// Primary key of the affected row, when applicable. AI searches use 0.
  entityId   Int
  /// Action-specific structured payload (before/after values, AI question + tool calls, etc.).
  metadata   Json?
  createdAt  DateTime      @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

// =============================================================================
//  Enums
// =============================================================================

enum UserRole {
  PI
  RESEARCH_ADMIN
  ADMIN
}

enum GrantRoleType {
  LEAD_PI
  CO_PI
  COLLABORATOR
}

enum GrantStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  CLOSED
  REJECTED
}

enum DeliverableType {
  PROGRESS_REPORT
  ANNUAL_REPORT
  FINAL_REPORT
  DATASET
  PUBLICATION
  MILESTONE
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REVISION_REQUESTED
  WITHDRAWN
}

enum AgencyType {
  FEDERAL
  STATE
  PRIVATE_FOUNDATION
  INDUSTRY
  INTERNAL
}

enum AuditAction {
  /// Generic CRUD.
  CREATE
  UPDATE
  DELETE
  /// Grant workflow transitions.
  GRANT_SUBMIT
  GRANT_APPROVE
  GRANT_REJECT
  GRANT_CLOSE
  /// Deliverable workflow.
  DELIVERABLE_SUBMIT
  DELIVERABLE_ACCEPT
  DELIVERABLE_REVISION_REQUESTED
  /// Identity / permissions.
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  /// AI search.
  AI_SEARCH_EXECUTED
}
